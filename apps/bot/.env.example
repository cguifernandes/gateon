# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Nest API origin used by the bot for internal callbacks
GATEON_API_BASE_URL=http://localhost:4000

# Must match apps/api TELEGRAM_BOT_INTERNAL_SECRET. Use a long random value.
TELEGRAM_BOT_INTERNAL_SECRET=

# Optional: PEM file(s) the Node process should trust in addition to bundled CAs
# (e.g. corporate TLS inspection root). Path is relative to apps/bot unless absolute.
# See apps/bot/certs/README.md
# NODE_EXTRA_CA_CERTS=certs/corp-root.pem

# Dev/start scripts already set NODE_OPTIONS=--use-system-ca (Node 22+). See package.json.
