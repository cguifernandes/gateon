{
  "name": "@gateon/bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "cross-env NODE_OPTIONS=--use-system-ca tsx watch src/main.ts",
    "start": "node --use-system-ca dist/main.js",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "grammy": "^1.38.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@biomejs/biome": "2.2.0",
    "@types/node": "^20.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
