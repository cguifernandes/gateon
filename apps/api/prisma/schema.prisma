// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts                       Accounts[]
  sessions                       Sessions[]
  telegramAccounts               TelegramAccounts[]
  telegramGroupConnectionIntents TelegramGroupConnectionIntents[]
  telegramGroups                 TelegramGroups[]
}

model Accounts {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Sessions {
  id                String    @id @default(cuid())
  expiresAt         DateTime
  tokenHash         String    @unique
  ipHash            String?
  userAgentHash     String?
  metadataExpiresAt DateTime?
  userId            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([metadataExpiresAt])
}

enum TelegramConnectionStatus {
  PENDING
  TELEGRAM_USER_CONFIRMED
  WAITING_FOR_PERMISSIONS
  CONNECTED
  EXPIRED
  FAILED
}

model TelegramAccounts {
  id             String   @id @default(cuid())
  userId         String
  telegramUserId String   @unique
  username       String?
  firstName      String?
  lastName       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TelegramGroupConnectionIntents {
  id                String                   @id @default(cuid())
  userId            String
  tokenHash         String                   @unique
  status            TelegramConnectionStatus @default(PENDING)
  telegramUserId    String?
  telegramChatId    String?
  telegramChatTitle String?
  telegramChatType  String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([telegramUserId, status])
  @@index([expiresAt])
}

model TelegramGroups {
  id                             String   @id @default(cuid())
  userId                         String
  telegramChatId                 String   @unique
  title                          String?
  chatPhotoFileId                String?
  type                           String
  addedByTelegramUserId          String
  botStatus                      String
  addedByProfilePhotoFileId      String?
  connectedAt                    DateTime @default(now())
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  user    Users                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  members TelegramGroupMembers[]

  @@index([userId])
  @@index([addedByTelegramUserId])
}

model TelegramGroupMembers {
  id                 String    @id @default(cuid())
  telegramGroupId    String
  telegramUserId     String
  username           String?
  firstName          String?
  lastName           String?
  profilePhotoFileId String?
  leftAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  group TelegramGroups @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)

  @@unique([telegramGroupId, telegramUserId])
  @@index([telegramGroupId])
  @@index([telegramGroupId, leftAt])
}
