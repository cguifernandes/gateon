// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts                       Accounts[]
  sessions                       Sessions[]
  telegramGroupConnectionIntents TelegramGroupConnectionIntents[]
  telegramGroups                 TelegramGroups[]
  telegramAlerts                 TelegramAlerts[]
  telegramAlertTemplates         TelegramAlertTemplates[]
  stripeBillingConnections       StripeBillingConnections[]
  stripeBillingCustomers         StripeBillingCustomers[]
  stripeBillingSubscriptions     StripeBillingSubscriptions[]
  stripeBillingPayments          StripeBillingPayments[]
  stripeBillingAuditLogs         StripeBillingAuditLogs[]
  telegramUserSettings           TelegramUserSettings?
  stripeTelegramMemberLinks      StripeTelegramMemberLinks[]
  stripeTelegramCheckoutSessions StripeTelegramCheckoutSessions[]
}

model Accounts {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Sessions {
  id                String    @id @default(cuid())
  expiresAt         DateTime
  tokenHash         String    @unique
  ipHash            String?
  userAgentHash     String?
  metadataExpiresAt DateTime?
  userId            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([metadataExpiresAt])
}

enum TelegramConnectionStatus {
  PENDING
  TELEGRAM_USER_CONFIRMED
  WAITING_FOR_PERMISSIONS
  CONNECTED
  EXPIRED
  FAILED
}

model TelegramGroupConnectionIntents {
  id                String                   @id @default(cuid())
  userId            String
  tokenHash         String                   @unique
  status            TelegramConnectionStatus @default(PENDING)
  telegramUserId    String?
  telegramChatId    String?
  telegramChatTitle String?
  telegramChatType  String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([telegramUserId, status])
  @@index([expiresAt])
}

model TelegramGroups {
  id                        String   @id @default(cuid())
  userId                    String
  telegramChatId            String   @unique
  title                     String?
  chatPhotoFileId           String?
  type                      String
  isForum                   Boolean  @default(false)
  addedByTelegramUserId     String
  botStatus                 String
  connectedAt               DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user                           Users                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  members                        TelegramGroupMembers[]
  settings                       TelegramGroupBotSettings?
  alerts                         TelegramAlerts[]
  forumTopics                    TelegramForumTopics[]
  stripeTelegramMemberLinks      StripeTelegramMemberLinks[]
  stripeTelegramCheckoutSessions StripeTelegramCheckoutSessions[]
  stripeBillingConnections       StripeBillingConnections[]

  @@index([userId])
  @@index([addedByTelegramUserId])
}

model TelegramForumTopics {
  id              String   @id @default(cuid())
  telegramGroupId String
  messageThreadId Int
  name            String
  iconColor       Int?
  isClosed        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group TelegramGroups @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)

  @@unique([telegramGroupId, messageThreadId])
  @@index([telegramGroupId])
}

model TelegramGroupBotSettings {
  id                   String   @id @default(cuid())
  telegramGroupId      String   @unique
  enabled              Boolean  @default(true)
  notifyPermissionLoss Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  group TelegramGroups @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)

  @@index([telegramGroupId])
}

model TelegramGroupMembers {
  id                 String    @id @default(cuid())
  telegramGroupId    String
  telegramUserId     String
  firstName          String?
  lastName           String?
  profilePhotoFileId String?
  isOwner            Boolean   @default(false)
  joinedAt           DateTime  @default(now())
  leftAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  group TelegramGroups @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)

  @@unique([telegramGroupId, telegramUserId])
  @@index([telegramGroupId])
  @@index([telegramGroupId, leftAt])
}

enum AlertStatus {
  DRAFT
  ACTIVE
  PAUSED
  FAILED
}

enum AlertDestinationType {
  GROUP
  TOPIC
  MEMBERS
  QUICK_ALERT
  AUTOMATION
}

enum AlertTriggerType {
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_BANNED
  FORUM_TOPIC_CREATED
  MEMBER_JOINED_GROUP_MESSAGE
  MEMBER_LEFT_PRIVATE_MESSAGE
  STRIPE_PAYMENT_SUCCEEDED
  STRIPE_PAYMENT_FAILED
  STRIPE_SUBSCRIPTION_EXPIRING
  STRIPE_SUBSCRIPTION_EXPIRED
  STRIPE_SUBSCRIPTION_RENEWED
  STRIPE_SUBSCRIPTION_CANCELED
}

enum AlertRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum AlertDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model TelegramAlerts {
  id              String               @id @default(cuid())
  userId          String
  telegramGroupId String?
  name            String
  internalTitle   String?
  status          AlertStatus          @default(DRAFT)
  destinationType AlertDestinationType
  messageThreadId Int?
  content         Json
  options         Json
  triggerType     AlertTriggerType?
  triggerConfig   Json?
  deliveryRate    Float                @default(0)
  lastRunAt       DateTime?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user    Users                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   TelegramGroups?        @relation(fields: [telegramGroupId], references: [id], onDelete: SetNull)
  targets TelegramAlertTargets[]
  runs    TelegramAlertRuns[]

  @@index([userId, status])
  @@index([telegramGroupId])
  @@index([destinationType])
}

model TelegramAlertTargets {
  id             String   @id @default(cuid())
  alertId        String
  telegramUserId String
  createdAt      DateTime @default(now())

  alert TelegramAlerts @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, telegramUserId])
  @@index([telegramUserId])
}

model TelegramAlertTemplates {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model TelegramAlertRuns {
  id             String         @id @default(cuid())
  alertId        String
  status         AlertRunStatus @default(PENDING)
  estimatedCount Int            @default(0)
  successCount   Int            @default(0)
  failCount      Int            @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  alert      TelegramAlerts            @relation(fields: [alertId], references: [id], onDelete: Cascade)
  deliveries TelegramAlertDeliveries[]

  @@index([alertId, createdAt])
  @@index([status])
}

model TelegramAlertDeliveries {
  id             String              @id @default(cuid())
  runId          String
  telegramUserId String?
  chatId         String?
  threadId       Int?
  status         AlertDeliveryStatus
  error          String?             @db.Text
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  run TelegramAlertRuns @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([telegramUserId])
}

enum StripeBillingConnectionStatus {
  CONNECTED
  DISCONNECTED
  FAILED
}

enum StripeBillingAuditAction {
  CONNECTION_CREATED
  CONNECTION_REMOVED
  CONSENT_ACCEPTED
  SYNC_EXECUTED
  PAYMENT_IDENTIFIED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_RENEWED
  AUTOMATION_TRIGGERED
  TELEGRAM_MEMBER_LINKED
}

enum StripeTelegramCheckoutStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

enum StripeTelegramMemberLinkStatus {
  ACTIVE
  REVOKED
}

model StripeBillingConnections {
  id                            String                        @id @default(cuid())
  userId                        String
  stripeAccountId               String?
  encryptedApiKey               String                        @db.Text
  apiKeyLast4                   String
  encryptedWebhookSigningSecret String?                       @db.Text
  status                        StripeBillingConnectionStatus @default(CONNECTED)
  lastSyncedAt                  DateTime?
  consentAcceptedAt             DateTime
  disconnectedAt                DateTime?
  activeSubscriptionCount       Int                           @default(0)
  expiringSubscriptionCount     Int                           @default(0)
  expiredSubscriptionCount      Int                           @default(0)
  customerCount                 Int                           @default(0)
  monthlyRevenueCents           Int                           @default(0)
  monitoredStripePriceId        String?
  monitoredStripeProductId      String?
  monitoredPlanLabel            String?
  telegramGroupId               String?
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt

  user             Users                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group            TelegramGroups?                  @relation(fields: [telegramGroupId], references: [id], onDelete: SetNull)
  customers        StripeBillingCustomers[]
  subscriptions    StripeBillingSubscriptions[]
  payments         StripeBillingPayments[]
  auditLogs        StripeBillingAuditLogs[]
  memberLinks      StripeTelegramMemberLinks[]
  checkoutSessions StripeTelegramCheckoutSessions[]

  @@index([userId, status])
  @@index([userId, monitoredStripePriceId])
  @@index([userId, telegramGroupId])
}

model StripeBillingCustomers {
  id               String   @id @default(cuid())
  userId           String
  connectionId     String
  stripeCustomerId String
  name             String?
  email            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          Users                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection    StripeBillingConnections     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  subscriptions StripeBillingSubscriptions[]
  payments      StripeBillingPayments[]

  @@unique([connectionId, stripeCustomerId])
  @@index([userId])
  @@index([email])
}

model StripeBillingSubscriptions {
  id                   String    @id @default(cuid())
  userId               String
  connectionId         String
  customerId           String?
  stripeSubscriptionId String
  stripeCustomerId     String?
  status               String
  planName             String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  lastEventType        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user       Users                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection StripeBillingConnections @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  customer   StripeBillingCustomers?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([connectionId, stripeSubscriptionId])
  @@index([userId, status])
  @@index([connectionId, currentPeriodEnd])
}

model StripeBillingPayments {
  id                    String    @id @default(cuid())
  userId                String
  connectionId          String
  customerId            String?
  stripePaymentIntentId String?
  stripeInvoiceId       String?
  stripeCustomerId      String?
  status                String
  amountCents           Int
  currency              String
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user       Users                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection StripeBillingConnections @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  customer   StripeBillingCustomers?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([connectionId, stripeInvoiceId])
  @@index([userId, status])
  @@index([connectionId, paidAt])
}

model StripeBillingAuditLogs {
  id           String                   @id @default(cuid())
  userId       String
  connectionId String?
  action       StripeBillingAuditAction
  metadata     Json?
  createdAt    DateTime                 @default(now())

  user       Users                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection StripeBillingConnections? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, action])
  @@index([connectionId, createdAt])
}

model TelegramUserSettings {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  publicStartToken             String   @unique
  welcomeMessageEnabled        Boolean  @default(true)
  welcomeMessage               String?  @db.Text
  showStripePlans              Boolean  @default(false)
  stripeConnectionIds          String[] @default([])
  showPaymentButtons           Boolean  @default(false)
  paymentButtonConnectionIds   String[] @default([])
  paymentButtonsGroupFirst     Boolean  @default(false)
  showSupportHint              Boolean  @default(true)
  supportHintText              String?  @db.Text
  showSubscribeSteps           Boolean  @default(true)
  autoRemoveExpiredSubscribers Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([publicStartToken])
}

model StripeTelegramCheckoutSessions {
  id                      String                       @id @default(cuid())
  userId                  String
  connectionId            String
  telegramUserId          String
  telegramGroupId         String?
  stripeCheckoutSessionId String                       @unique
  stripePriceId           String
  status                  StripeTelegramCheckoutStatus @default(PENDING)
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  completedAt             DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  user       Users                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection StripeBillingConnections @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  group      TelegramGroups?          @relation(fields: [telegramGroupId], references: [id], onDelete: SetNull)

  @@index([userId, telegramUserId])
  @@index([connectionId, status])
}

model StripeTelegramMemberLinks {
  id                   String                         @id @default(cuid())
  userId               String
  connectionId         String
  telegramGroupId      String
  telegramUserId       String
  stripeCustomerId     String
  stripeSubscriptionId String?
  status               StripeTelegramMemberLinkStatus @default(ACTIVE)
  linkedAt             DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  user       Users                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection StripeBillingConnections @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  group      TelegramGroups           @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)

  @@unique([connectionId, telegramUserId])
  @@index([userId, telegramGroupId])
  @@index([stripeCustomerId])
  @@index([telegramUserId, status])
}
