// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts                       Accounts[]
  sessions                       Sessions[]
  telegramAccounts               TelegramAccounts[]
  telegramGroupConnectionIntents TelegramGroupConnectionIntents[]
  telegramGroups                 TelegramGroups[]
  telegramAlerts                 TelegramAlerts[]
  telegramAlertTemplates         TelegramAlertTemplates[]
}

model Accounts {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Sessions {
  id                String    @id @default(cuid())
  expiresAt         DateTime
  tokenHash         String    @unique
  ipHash            String?
  userAgentHash     String?
  metadataExpiresAt DateTime?
  userId            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([metadataExpiresAt])
}

enum TelegramConnectionStatus {
  PENDING
  TELEGRAM_USER_CONFIRMED
  WAITING_FOR_PERMISSIONS
  CONNECTED
  EXPIRED
  FAILED
}

model TelegramAccounts {
  id             String   @id @default(cuid())
  userId         String
  telegramUserId String   @unique
  firstName      String?
  lastName       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TelegramGroupConnectionIntents {
  id                String                   @id @default(cuid())
  userId            String
  tokenHash         String                   @unique
  status            TelegramConnectionStatus @default(PENDING)
  telegramUserId    String?
  telegramChatId    String?
  telegramChatTitle String?
  telegramChatType  String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([telegramUserId, status])
  @@index([expiresAt])
}

model TelegramGroups {
  id                        String   @id @default(cuid())
  userId                    String
  telegramChatId            String   @unique
  title                     String?
  chatPhotoFileId           String?
  type                      String
  isForum                   Boolean  @default(false)
  addedByTelegramUserId     String
  botStatus                 String
  addedByProfilePhotoFileId String?
  connectedAt               DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user        Users                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  members     TelegramGroupMembers[]
  settings    TelegramGroupBotSettings?
  alerts      TelegramAlerts[]
  forumTopics TelegramForumTopics[]

  @@index([userId])
  @@index([addedByTelegramUserId])
}

model TelegramForumTopics {
  id              String   @id @default(cuid())
  telegramGroupId String
  messageThreadId Int
  name            String
  iconColor       Int?
  isClosed        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group TelegramGroups @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)

  @@unique([telegramGroupId, messageThreadId])
  @@index([telegramGroupId])
}

model TelegramGroupBotSettings {
  id                   String   @id @default(cuid())
  telegramGroupId      String   @unique
  enabled              Boolean  @default(true)
  welcomeEnabled       Boolean  @default(false)
  welcomeMessage       String   @default("Bem-vindo, {name}! Sua entrada no grupo foi registrada com sucesso.") @db.Text
  privateMessageOnJoin Boolean  @default(false)
  notifyPermissionLoss Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  group TelegramGroups @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)

  @@index([telegramGroupId])
}

model TelegramGroupMembers {
  id                 String    @id @default(cuid())
  telegramGroupId    String
  telegramUserId     String
  firstName          String?
  lastName           String?
  profilePhotoFileId String?
  isOwner            Boolean   @default(false)
  joinedAt           DateTime  @default(now())
  leftAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  group TelegramGroups @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)

  @@unique([telegramGroupId, telegramUserId])
  @@index([telegramGroupId])
  @@index([telegramGroupId, leftAt])
}

enum AlertStatus {
  DRAFT
  ACTIVE
  PAUSED
  FAILED
}

enum AlertDestinationType {
  GROUP
  TOPIC
  MEMBERS
  QUICK_ALERT
  AUTOMATION
}

enum AlertTriggerType {
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_BANNED
  FORUM_TOPIC_CREATED
}

enum AlertRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum AlertDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model TelegramAlerts {
  id              String               @id @default(cuid())
  userId          String
  telegramGroupId String?
  name            String
  internalTitle   String?
  status          AlertStatus          @default(DRAFT)
  destinationType AlertDestinationType
  messageThreadId Int?
  content         Json
  options         Json
  triggerType     AlertTriggerType?
  triggerConfig   Json?
  deliveryRate    Float                @default(0)
  lastRunAt       DateTime?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user    Users                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   TelegramGroups?        @relation(fields: [telegramGroupId], references: [id], onDelete: SetNull)
  targets TelegramAlertTargets[]
  runs    TelegramAlertRuns[]

  @@index([userId, status])
  @@index([telegramGroupId])
  @@index([destinationType])
}

model TelegramAlertTargets {
  id             String   @id @default(cuid())
  alertId        String
  telegramUserId String
  createdAt      DateTime @default(now())

  alert TelegramAlerts @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, telegramUserId])
  @@index([telegramUserId])
}

model TelegramAlertTemplates {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model TelegramAlertRuns {
  id             String         @id @default(cuid())
  alertId        String
  status         AlertRunStatus @default(PENDING)
  estimatedCount Int            @default(0)
  successCount   Int            @default(0)
  failCount      Int            @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  alert      TelegramAlerts            @relation(fields: [alertId], references: [id], onDelete: Cascade)
  deliveries TelegramAlertDeliveries[]

  @@index([alertId, createdAt])
  @@index([status])
}

model TelegramAlertDeliveries {
  id             String              @id @default(cuid())
  runId          String
  telegramUserId String?
  chatId         String?
  threadId       Int?
  status         AlertDeliveryStatus
  error          String?             @db.Text
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  run TelegramAlertRuns @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([telegramUserId])
}
