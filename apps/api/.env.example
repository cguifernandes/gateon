# Nest API port (avoid clashing with Next.js on 3000)
PORT=4000

# Postgres connection used by Prisma (apps/api)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gateon?schema=public"

# Frontend origin for CORS (where the web app is served; no trailing slash)
WEB_BASE_URL=http://localhost:3000

# Session cookie lifetime (days)
SESSION_TTL_DAYS=7

# Retention window for hashed session metadata (ipHash/userAgentHash), in days
SESSION_METADATA_TTL_DAYS=7

# Secret used to HMAC-hash sensitive values before persistence.
# Required in production.
DATA_HASH_SECRET=change-me-in-production

# Optional: share cookies across subdomains (e.g. ".example.com")
# COOKIE_DOMAIN=

NODE_ENV=development

# Google OAuth (authorization code flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized redirect URI in Google Cloud Console (Nest API URL + path)
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# If token exchange logs "fetch failed" toward Google (common on some Windows / IPv6 setups), try:
# GOOGLE_OAUTH_DNS_IPV4_FIRST=true
