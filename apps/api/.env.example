# Nest API port (avoid clashing with Next.js on 3000)
PORT=4000

# Postgres connection used by Prisma (apps/api)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gateon?schema=public"

# Frontend origin for CORS (where the web app is served; no trailing slash)
WEB_BASE_URL=http://localhost:3000

# Checkout Stripe no celular em dev: localhost não abre no telefone. Opções:
# 1) (Recomendado p/ testar finalize na web) Exponha o Next com ngrok/cloudflared e defina a URL pública aqui:
# STRIPE_CHECKOUT_PUBLIC_BASE_URL=https://SEU-TUNEL.ngrok-free.app
# 2) Sem túnel: em NODE_ENV=development a API redireciona success/cancel para o bot no Telegram
#    e reconcilia o pagamento automaticamente a cada poucos segundos (STRIPE_DEV_AUTO_RECONCILE_CHECKOUT).
# STRIPE_DEV_AUTO_RECONCILE_CHECKOUT=true

# Session cookie lifetime (days)
SESSION_TTL_DAYS=7

# Retention window for hashed session metadata (ipHash/userAgentHash), in days
SESSION_METADATA_TTL_DAYS=7

# Global API rate limit. Tune per environment and ingress/proxy policy.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Secret used to HMAC-hash sensitive values before persistence.
# Required in production.
DATA_HASH_SECRET=change-me-in-production

# Secret used to encrypt reversible integration secrets such as Stripe API keys.
# Use a strong random value in production; 32 bytes encoded as 64 hex chars is recommended.
SECRET_ENCRYPTION_KEY=change-me-in-production

# Stripe webhooks — alertas em tempo real (sem precisar sincronizar manualmente).
# URL pública da API (sem barra final). Usada para montar o endpoint exibido em Integrações.
# API_PUBLIC_BASE_URL=https://api.seudominio.com
# Signing secret global (dev com `stripe listen`). Em produção, prefira salvar por integração na UI.
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...

# Optional: share cookies across subdomains (e.g. ".example.com")
# COOKIE_DOMAIN=

NODE_ENV=development

# Google OAuth (authorization code flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized redirect URI in Google Cloud Console (Nest API URL + path)
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# If token exchange logs "fetch failed" toward Google (common on some Windows / IPv6 setups), try:
# GOOGLE_OAUTH_DNS_IPV4_FIRST=true

# Telegram bot used to generate secure deep links for group connection.
TELEGRAM_BOT_USERNAME=GateonBot
# Optional: bot token used by the API to read basic group data for test pages.
TELEGRAM_BOT_TOKEN=
# If HTTPS calls to api.telegram.org fail with UNABLE_TO_VERIFY_LEAF_SIGNATURE (common on
# Windows with corporate proxy / antivirus HTTPS inspection), either:
# - Use Node 20.17+ and run the API with --use-system-ca (the `npm run dev` script in apps/api does this), or
# - Point to your corporate root CA PEM (absolute path, or relative to the apps/api folder):
# NODE_EXTRA_CA_CERTS=certs/corp-root.pem
# Avoid NODE_TLS_REJECT_UNAUTHORIZED=0 except brief local experiments (disables TLS verification).
# Shared secret required for bot -> API internal callbacks. Use a long random value.
TELEGRAM_BOT_INTERNAL_SECRET=change-me-in-production
# Short-lived group connection intent lifetime, in minutes.
TELEGRAM_GROUP_CONNECTION_TTL_MINUTES=15
