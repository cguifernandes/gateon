# Server-only: URL do Nest (mesma máquina em dev). Precisa bater com PORT da API (ex. 4000).
# A API tem de estar rodando — senão o register/login falham com ECONNREFUSED no servidor Next.
INTERNAL_API_URL=http://localhost:4000

# Produção (Vercel): URL pública da API no Render, sem barra no final.
# Ex.: https://gateon-api.onrender.com
# Usada no OAuth (browser) e repassada à API para montar URLs de webhook em Integrações.
# Se login der timeout, confira também DATABASE_URL na API (Supabase Session pooler).
# UPSTREAM_FETCH_TIMEOUT_MS=45000

# Alias aceito pelo código (use um dos dois)
# API_URL=http://localhost:4000

# Browser: OAuth Google redireciona para esta origem (GET /auth/google). Deve ser a mesma base que a API expõe.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Checkout Stripe → redirect de volta ao bot após pagamento/cancelamento (sem @ no início)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=GateonBot

# Sentry (monitoramento de erros no frontend e rotas BFF)
# Crie um projeto em https://sentry.io — plano gratuito cobre erros básicos
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: ambiente exibido no Sentry (production, preview, development)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Opcional: amostragem de performance traces (0.0–1.0). Padrão: 0.1 em prod, 1 em dev
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Opcional: upload de source maps no build (Vercel). Sem token, o build funciona sem upload.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Microsoft Clarity (mapa de calor, gravação de sessão e relatórios de comportamento)
# Crie um projeto gratuito em https://clarity.microsoft.com e copie o Project ID
# Sem essa variável, o script não é carregado
NEXT_PUBLIC_CLARITY_PROJECT_ID=
