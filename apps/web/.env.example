# Server-only: URL do Nest (mesma máquina em dev). Precisa bater com PORT da API (ex. 4000).
# A API tem de estar rodando — senão o register/login falham com ECONNREFUSED no servidor Next.
INTERNAL_API_URL=http://localhost:4000

