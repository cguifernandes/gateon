{
  "name": "gateon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check apps/web apps/api",
    "lint:web": "biome check apps/web",
    "lint:api": "biome check apps/api",
    "format": "biome format --write apps/web apps/api",
    "format:web": "biome format --write apps/web",
    "format:api": "biome format --write apps/api",
    "dev:web": "turbo dev --filter=@gateon/web",
    "dev:api": "turbo dev --filter=@gateon/api",
    "build:web": "turbo build --filter=@gateon/web",
    "build:api": "turbo build --filter=@gateon/api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "turbo": "^2.5.3"
  }
}
